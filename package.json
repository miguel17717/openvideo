{
  "name": "openvideo",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable local video production system with Codex, OpenMontage, Remotion and FFmpeg",
  "type": "module",
  "scripts": {
    "configure": "node scripts/configure-local.mjs",
    "audit:public": "node scripts/audit-public.mjs",
    "project:new": "node scripts/new-project.mjs",
    "project:render": "node scripts/render-project.mjs",
    "dev": "npm run build && node scripts/start.mjs",
    "dev:hot": "tsx backend/src/server.ts",
    "build": "vite build --config frontend/vite.config.ts --configLoader runner && tsc -p backend/tsconfig.json",
    "start": "node scripts/start.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
